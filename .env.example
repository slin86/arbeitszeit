# --- Pflicht in Produktion ---
AZ_SECRET_KEY=bitte-lange-zufaellige-zeichenfolge   # python -c "import secrets;print(secrets.token_urlsafe(48))"
AZ_BASE_URL=https://zeit.example.com                 # öffentliche URL (für OIDC-Redirect)
AZ_HTTPS_ONLY=true

# --- Datenbank (SQLite Standard; PostgreSQL: pip install .[postgres]) ---
# AZ_DATABASE_URL=sqlite:///./data/arbeitszeit.db
# AZ_DATABASE_URL=postgresql+psycopg://user:pass@db/arbeitszeit

# --- Erster Administrator (nur beim allerersten Start, wenn noch kein Benutzer existiert) ---
AZ_ADMIN_EMAIL=admin@example.com
AZ_ADMIN_PASSWORD=ein-langes-passwort

# --- Arbeitszeit-Regeln ---
AZ_DEFAULT_ANNUAL_HOURS=1700
AZ_DEFAULT_VACATION_DAYS=25
AZ_DEFAULT_STATE=NW          # Bundesland für Feiertage (BW, BY, BE, ..., NW, ...)
AZ_SHUTDOWN_START=12-24      # Betriebsferien (MM-TT), jedes Jahr
AZ_SHUTDOWN_END=12-31
AZ_VACATION_IN_ANNUAL_HOURS=false

# --- Anmeldung ---
AZ_LOCAL_LOGIN_ENABLED=true
AZ_OIDC_AUTO_CREATE_USERS=true
AZ_OIDC_LINK_BY_EMAIL=true

# Microsoft Entra ID (Azure AD) – Redirect-URI in der App-Registrierung: {AZ_BASE_URL}/auth/azure/callback
# AZ_OIDC_AZURE_TENANT_ID=
# AZ_OIDC_AZURE_CLIENT_ID=
# AZ_OIDC_AZURE_CLIENT_SECRET=

# Google – Redirect-URI: {AZ_BASE_URL}/auth/google/callback
# AZ_OIDC_GOOGLE_CLIENT_ID=
# AZ_OIDC_GOOGLE_CLIENT_SECRET=

# Beliebiger OIDC-Provider (Keycloak, Authentik, Okta, Auth0 …) – Redirect-URI: {AZ_BASE_URL}/auth/sso/callback
# AZ_OIDC_GENERIC_LABEL=Firmen-SSO
# AZ_OIDC_GENERIC_METADATA_URL=https://sso.example.com/realms/firma/.well-known/openid-configuration
# AZ_OIDC_GENERIC_CLIENT_ID=
# AZ_OIDC_GENERIC_CLIENT_SECRET=
